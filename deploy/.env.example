# Copy to .env next to compose.yaml and fill in what you use.

# Root key for the gateway admin API (/admin/*).
AGENTOS_ADMIN_KEY=change-me

# Virtual key the runtime uses against the gateway (bootstrapped with a $25 budget).
AGENTOS_RUNTIME_KEY=agos-local-dev-runtime

# Model the agent uses, as <provider>/<model>.
# anthropic/claude-sonnet-5 | openai/gpt-4o-mini | ollama/llama3.1
AGENTOS_MODEL=anthropic/claude-sonnet-5

# Provider credentials — set the one(s) your model needs.
AGENTOS_ANTHROPIC_API_KEY=
AGENTOS_OPENAI_API_KEY=
# For local models, e.g. http://host.docker.internal:11434
AGENTOS_OLLAMA_BASE_URL=

# --- Phase 2 ---
# Prompt-injection guardrail at the gateway: off | log | block
AGENTOS_GUARDRAILS_MODE=off
# Comma-separated tool names that require human approval (empty = off).
# The deploy/compose.hitl.yaml overlay sets this to "query" and guardrails to
# "block" in one shot.
AGENTOS_APPROVAL_TOOLS=
# Embedding model for the context engine, via the gateway.
AGENTOS_EMBED_MODEL=ollama/bge-m3
# Agent architecture: react (default) | deep (deepagents planner)
AGENTOS_AGENT_PROFILE=react

# --- Operators (native autonomy) ---
# The scheduler is OFF by default: the runtime serves the /operators API but
# never fires on its own until this is true. interval/cron operators then fire
# on their schedule; webhook operators always fire only on their endpoint.
# AGENTOS_AUTONOMY_ENABLED=false
# How often the scheduler checks for due operators (seconds).
# AGENTOS_AUTONOMY_TICK_S=15
# Default tool-iteration cap for an operator that sets none.
# AGENTOS_AUTONOMY_MAX_CYCLES=8
# In-repo SKILL.md directory (default: the image-baked runtime/skills).
# AGENTOS_SKILLS_DIR=
# Cap the history sent to the model each turn (react profile). A long-running
# agent resends the whole thread every turn and eventually exceeds the model's
# window; trimming keeps the newest messages plus the safety frame. 0 = off.
# The deep profile summarises on its own and ignores this.
# AGENTOS_MAX_CONTEXT_TOKENS=0
# Host port for the admin console.
AGENTOS_CONSOLE_PORT=3000

# --- Phase 3 ---
# Sandboxed code execution for agents (run_python tool). Empty disables.
# Compose sets http://sandbox:8070 automatically. The sandbox runs on an
# internal-only network (Phase 4) and publishes no host port.
# Legacy REST demo (CRM) + REST->MCP connector host ports.
AGENTOS_CRM_PORT=8095
AGENTOS_REST_PORT=8091
# OTel collector host port (compose.otel.yaml overlay).
AGENTOS_OTEL_PORT=4318

# --- Phase 4: SSH connector (opt-in; no live target in the demo) ---
# AGENTOS_SSH_HOST=
# AGENTOS_SSH_USER=
# AGENTOS_SSH_PASSWORD=        # or AGENTOS_SSH_PRIVATE_KEY (PEM)
# AGENTOS_SSH_ALLOW_COMMANDS=ls,cat,grep,df,uptime   # empty = deny all
# AGENTOS_SSH_KNOWN_HOSTS=     # unset = insecure host-key (warns at startup)

# --- Phase 4: model-based guardrail (AGENTOS_GUARDRAILS_MODE=model) ---
# Classifier model + a gateway virtual key so its spend shows in /admin/usage.
AGENTOS_GUARDRAILS_MODEL=anthropic/claude-haiku-4-5
# AGENTOS_GUARDRAILS_KEY=${AGENTOS_RUNTIME_KEY}

# --- Phase 4: LLM-judge evals ---
AGENTOS_JUDGE_MODEL=anthropic/claude-haiku-4-5

# --- Phase 4: Langfuse profile (see deploy/langfuse.env.example for the full set) ---
# AGENTOS_LANGFUSE_PORT=3001
# LANGFUSE_IMAGE=langfuse/langfuse:2   # set :3 (+ClickHouse/Redis/MinIO) for OTLP-into-UI

# Phase 4 guardrail tuning (model mode)
# AGENTOS_GUARDRAILS_TIMEOUT_S=20      # classifier screening budget (both attempts)
# AGENTOS_GUARDRAILS_MAX_TOKENS=512    # raise for reasoning-model classifiers

# --- Phase 5: RBAC + secrets ---
AGENTOS_BOOTSTRAP_ORG=default
# Secrets backend: env (default) | file | age
AGENTOS_SECRETS_BACKEND=env
# AGENTOS_SECRETS_FILE=/run/secrets/agentos.json   # for file/age backends
# AGENTOS_SECRETS_AGE_KEY=AGE-SECRET-KEY-...        # age identity (age backend)

# --- Phase 5: opt-in connectors (docker compose --profile connectors up -d) ---
# AGENTOS_SOAP_WSDL_URL=http://your-legacy/service?wsdl
# AGENTOS_SOAP_PORT=8093
# AGENTOS_BROWSER_ALLOW_DOMAINS=example.com,docs.example.com   # empty = deny all
# AGENTOS_BROWSER_PORT=8094

# --- Phase 6: identity, rate limits, Vault ---
# Global default rate limit (requests/min per org; 0 = unlimited).
AGENTOS_RATE_LIMIT_RPM=0

# --- Multiverse frontier providers (config-driven registry) ---
# All ship disabled in deploy/providers.json. To enable one: confirm the base
# URL, model id, and per-1M-token pricing in that file, set its key here, and
# flip "enabled" to true. Leaving a key empty keeps that provider unroutable.
# AGENTOS_MOONSHOT_API_KEY=
# AGENTOS_ZHIPU_API_KEY=
# AGENTOS_ALIBABA_API_KEY=
# AGENTOS_DEEPSEEK_API_KEY=
# AGENTOS_MINIMAX_API_KEY=
# Path to the registry file inside the container (compose mounts it here).
# AGENTOS_PROVIDERS_FILE=/app/providers.json

# --- Request admission limits ---
# Amount held against a key's budget while a request is in flight. A call's real
# cost is unknown until the provider answers, so admission works from this
# estimate and settles afterwards; it is what stops concurrent requests (a
# Multiverse council fans out five at once) from each being approved against the
# same pre-spend snapshot. Raise it above a typical request cost for expensive
# models — too low and a burst can still nudge past a budget.
# AGENTOS_BUDGET_RESERVE_USD=0.05
# Maximum request body. Without a cap every JSON decode reads until the client
# stops sending. Generous by default because chat payloads carry whole
# conversations and retrieved documents.
# AGENTOS_MAX_BODY_BYTES=10485760
# How long a single agent-issued SQL query may run. The row cap bounds how much
# comes back but not how long it takes, and cancelling the client does not stop
# a Postgres backend that is already executing.
# AGENTOS_CONNECTOR_STATEMENT_TIMEOUT_S=30
# Audit retention in days. OFF by default and deliberately so: the audit log is
# the evidence of what every key did, so discarding it silently would be a worse
# failure than an oversized table. Set it once you have decided how long you are
# required to keep it.
# AGENTOS_AUDIT_RETENTION_DAYS=90
# Vault KV v2 secrets backend (set AGENTOS_SECRETS_BACKEND=vault):
# AGENTOS_VAULT_ADDR=http://vault:8200
# AGENTOS_VAULT_TOKEN=...
# AGENTOS_VAULT_KV_PATH=secret/data/agentos
# OIDC SSO (set the issuer to enable; console shows an SSO button):
# AGENTOS_OIDC_ISSUER=https://your-idp/.well-known lives at {issuer}/.well-known/openid-configuration
# AGENTOS_OIDC_CLIENT_ID=agentos-console
# AGENTOS_OIDC_CLIENT_SECRET=...
# AGENTOS_OIDC_REDIRECT_URL=http://localhost:8080/auth/oidc/callback
# AGENTOS_OIDC_POST_LOGIN_URL=http://localhost:3000/
# AGENTOS_OIDC_DEFAULT_ORG=org_default
# AGENTOS_OIDC_DEFAULT_ROLE=member

# --- Phase 7: SCIM, distributed limits, secret rotation ---
# SCIM 2.0 provisioning (set a token to enable /scim/v2/*; IdP uses it as Bearer).
# AGENTOS_SCIM_TOKEN=...
# AGENTOS_SCIM_DEFAULT_ORG=org_default
# AGENTOS_SCIM_DEFAULT_ROLE=member
# Rate-limit store: memory (default, per-instance) | postgres (shared across replicas).
AGENTOS_RATELIMIT_BACKEND=memory
# Background secret refresh interval in seconds (0 = off; file/vault/age only).
AGENTOS_SECRETS_REFRESH_S=0

# --- Security hardening (Phase 8) ---
# Runtime API auth: REQUIRED. The runtime refuses to start without it; the
# console nginx injects it as a Bearer token (never reaches the browser).
AGENTOS_RUNTIME_AUTH_TOKEN=change-me-runtime
# SSH connector: require a known_hosts file (fail-closed). Dev-only opt-out:
# AGENTOS_SSH_INSECURE_HOST_KEY=true
