# Copy to .env next to compose.yaml and fill in what you use.

# Root key for the gateway admin API (/admin/*).
AGENTOS_ADMIN_KEY=change-me

# Virtual key the runtime uses against the gateway (bootstrapped with a $25 budget).
AGENTOS_RUNTIME_KEY=agos-local-dev-runtime

# Model the agent uses, as <provider>/<model>.
# anthropic/claude-sonnet-5 | openai/gpt-4o-mini | ollama/llama3.1
AGENTOS_MODEL=anthropic/claude-sonnet-5

# Provider credentials — set the one(s) your model needs.
AGENTOS_ANTHROPIC_API_KEY=
AGENTOS_OPENAI_API_KEY=
# For local models, e.g. http://host.docker.internal:11434
AGENTOS_OLLAMA_BASE_URL=
