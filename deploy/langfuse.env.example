# --- Langfuse observability profile (deploy/compose.langfuse.yaml) ---

# Host port for the Langfuse UI (container listens on 3000).
AGENTOS_LANGFUSE_PORT=3001

# Session-cookie signing secret and API-key encryption salt for Langfuse.
# Generate each with: openssl rand -base64 32
# (compose falls back to insecure local-dev values if unset — fine for a laptop,
# never for anything shared.)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# Where the OTel collector forwards traces. Default targets the bundled
# Langfuse service on the compose network; point at cloud.langfuse.com to use
# Langfuse Cloud instead.
LANGFUSE_OTLP_ENDPOINT=http://langfuse:3000/api/public/otel

# base64("public_key:secret_key") of a Langfuse project API key pair, obtained
# AFTER first boot: open http://localhost:3001, create an org + project, copy
# the pk-lf-.../sk-lf-... keys from project settings, then:
#   echo -n "pk-lf-xxx:sk-lf-xxx" | base64 -w0
# and restart the collector: docker compose ... restart otel-collector
LANGFUSE_OTLP_BASIC_AUTH=
