server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Same-origin API: strip /api/gateway and /api/runtime prefixes and proxy
    # to the compose services (trailing slash on proxy_pass strips the prefix).
    location /api/gateway/ {
        proxy_pass http://gateway:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # SSE passthrough for streamed chat completions.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /api/runtime/ {
        proxy_pass http://runtime:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The runtime requires a bearer token on every route (except /healthz).
        # nginx injects it server-side so the browser never holds it; the value
        # is substituted from the AGENTOS_RUNTIME_AUTH_TOKEN container env var at
        # startup (see docker-entrypoint.sh). This is the ONLY variable expanded
        # by envsubst, so nginx's own $host/$uri are preserved.
        proxy_set_header Authorization "Bearer ${AGENTOS_RUNTIME_AUTH_TOKEN}";
        # SSE passthrough for /runs/stream.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # SPA fallback: client-side routes resolve to the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
