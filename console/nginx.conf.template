server {
    # 8080, not 80: the server runs unprivileged and cannot bind a low port.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Same-origin API: strip /api/gateway and /api/runtime prefixes and proxy
    # to the compose services (trailing slash on proxy_pass strips the prefix).
    location /api/gateway/ {
        proxy_pass http://gateway:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # SSE passthrough for streamed chat completions.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /api/runtime/ {
        proxy_pass http://runtime:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The runtime requires a bearer token on every route except /healthz and
        # POST /operators/webhooks/{token}, where the opaque whk- token in the path is
        # itself the credential. This proxy injects the bearer server-side, so it never
        # reaches the browser — and so anything that can reach this port has full
        # runtime authority.
        proxy_set_header Authorization "Bearer ${AGENTOS_RUNTIME_AUTH_TOKEN}";
        # SSE passthrough for /runs/stream.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Build output is content-hashed by Vite, so a given filename's bytes never
    # change: cache it indefinitely and skip revalidation entirely.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback: client-side routes resolve to the app shell. The shell is the
    # only file naming the hashed bundles, so it must be revalidated every load —
    # a cached copy points the browser at asset filenames a rebuild has deleted,
    # leaving a stale or blank app. "no-cache" still allows a 304 via ETag.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
